# Stage 1: build
FROM node:20-alpine AS builder

WORKDIR /app

# No NODE_ENV=production here: vite and tsc live in devDependencies, and the
# build needs them.
COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: runner — plain nginx over the built assets, no node in the image.
FROM nginx:alpine AS runner

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Matches `listen 80` in nginx.conf; the host maps it to a free port.
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
